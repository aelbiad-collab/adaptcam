---
import type { Job } from '../data/jobs';

interface Props {
  job: Job;
}

const { job } = Astro.props;
const hasChoice = job.typeContrat === 'Freelance ou CDI';
const infoLabel = job.infoDemandee === 'tjm' ? 'TJM (MAD/jour)' : 'Prétentions salariales';
const infoPlaceholder = hasChoice
  ? "Choisissez d'abord un type de contrat"
  : job.infoDemandee === 'tjm' ? 'xxxx MAD/jour' : 'xxxx MAD/mois';
---

<form id="apply-form" data-slug={job.slug} data-poste={job.intitule} data-lieu={job.lieu} data-contrat={job.typeContrat} data-objet={job.objetMail} data-has-choice={hasChoice ? 'true' : 'false'} data-info-label={infoLabel} novalidate class="rounded-2xl border border-border bg-paper-dim p-6 sm:p-8">
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="nom" class="mb-1 block text-sm font-semibold text-ink">Nom <span class="text-accent">*</span></label>
      <input type="text" id="nom" name="nom" required class="w-full rounded-lg border border-border bg-white px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none" />
    </div>
    <div>
      <label for="prenom" class="mb-1 block text-sm font-semibold text-ink">Prénom <span class="text-accent">*</span></label>
      <input type="text" id="prenom" name="prenom" required class="w-full rounded-lg border border-border bg-white px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none" />
    </div>
    <div>
      <label for="telephone" class="mb-1 block text-sm font-semibold text-ink">Téléphone <span class="text-accent">*</span></label>
      <input type="tel" id="telephone" name="telephone" required class="w-full rounded-lg border border-border bg-white px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none" />
    </div>
    <div>
      <label for="email" class="mb-1 block text-sm font-semibold text-ink">Email <span class="text-accent">*</span></label>
      <input type="email" id="email" name="email" required class="w-full rounded-lg border border-border bg-white px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none" />
    </div>
    {hasChoice && (
      <div class="sm:col-span-2">
        <label class="mb-1 block text-sm font-semibold text-ink">Type de contrat souhaité <span class="text-accent">*</span></label>
        <div class="flex gap-6">
          <label class="flex items-center gap-2 text-sm text-ink">
            <input type="radio" name="typeContratSouhaite" value="Freelance" required class="accent-accent" />
            Freelance
          </label>
          <label class="flex items-center gap-2 text-sm text-ink">
            <input type="radio" name="typeContratSouhaite" value="CDI" required class="accent-accent" />
            CDI
          </label>
        </div>
      </div>
    )}
    <div>
      <label for="infoValeur" class="mb-1 block text-sm font-semibold text-ink"><span id="info-label-text">{infoLabel}</span> <span class="text-accent">*</span></label>
      <input type="text" id="infoValeur" name="infoValeur" required disabled={hasChoice} placeholder={infoPlaceholder} class="w-full rounded-lg border border-border bg-white px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none disabled:cursor-not-allowed disabled:bg-paper-dim disabled:text-muted" />
    </div>
    <div>
      <label for="disponibilite" class="mb-1 block text-sm font-semibold text-ink">Disponibilité <span class="text-accent">*</span></label>
      <select id="disponibilite" name="disponibilite" required class="w-full rounded-lg border border-border bg-white px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none">
        <option value="">Sélectionner...</option>
        <option>Immédiate</option>
        <option>Sous 15 jours</option>
        <option>Sous 1 mois</option>
        <option>Préavis en cours</option>
      </select>
    </div>
  </div>

  <div class="mt-4">
    <label for="message" class="mb-1 block text-sm font-semibold text-ink">Message (optionnel)</label>
    <textarea id="message" name="message" rows="3" placeholder="Informations complémentaires..." class="w-full rounded-lg border border-border bg-white px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none"></textarea>
  </div>

  <div class="mt-4">
    <label class="mb-1 block text-sm font-semibold text-ink">CV (PDF ou Word) <span class="text-accent">*</span></label>
    <div id="file-drop" class="cursor-pointer rounded-lg border-2 border-dashed border-border bg-white px-4 py-6 text-center transition hover:border-accent">
      <p class="text-sm text-muted">📎 Cliquez pour joindre votre CV</p>
      <p class="mt-1 text-xs text-muted">PDF ou DOCX, 5 Mo maximum</p>
      <input type="file" id="cv" name="cv" accept=".pdf,.doc,.docx" required class="hidden" />
      <p id="file-name" class="mt-2 text-sm font-semibold text-accent-dark"></p>
    </div>
  </div>

  <button type="submit" id="submit-btn" class="mt-6 w-full rounded-lg bg-accent px-4 py-3 text-sm font-bold text-white transition hover:bg-accent-dark disabled:cursor-not-allowed disabled:opacity-60">
    Envoyer ma candidature
  </button>
  <p id="form-status" class="mt-3 hidden rounded-lg px-4 py-2.5 text-sm"></p>
</form>

<script>
  const WEBAPP_URL = 'https://script.google.com/macros/s/AKfycbynBFSqXln24slmb53WF6DZ3wwMAjYqxFjoT7F9WvIv91GbMZOiCAnYqClOsB-RIBLP/exec';
  const MAX_FILE_SIZE = 5 * 1024 * 1024;

  function fileToBase64(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve((reader.result as string).split(',')[1]);
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  document.querySelectorAll<HTMLFormElement>('#apply-form').forEach((form) => {
    const fileInput = form.querySelector<HTMLInputElement>('#cv')!;
    const fileDrop = form.querySelector<HTMLElement>('#file-drop')!;
    const fileNameEl = form.querySelector<HTMLElement>('#file-name')!;
    const statusEl = form.querySelector<HTMLElement>('#form-status')!;
    const submitBtn = form.querySelector<HTMLButtonElement>('#submit-btn')!;
    const hasChoice = form.dataset.hasChoice === 'true';
    const infoInput = form.querySelector<HTMLInputElement>('#infoValeur')!;
    const infoLabelEl = form.querySelector<HTMLElement>('#info-label-text')!;
    const contratRadios = form.querySelectorAll<HTMLInputElement>('input[name="typeContratSouhaite"]');

    function infoLabelFor(contrat: string) {
      return contrat === 'Freelance' ? 'TJM (MAD/jour)' : 'Prétentions salariales';
    }

    if (hasChoice) {
      contratRadios.forEach((radio) => {
        radio.addEventListener('change', () => {
          const label = infoLabelFor(radio.value);
          infoLabelEl.textContent = label;
          infoInput.placeholder = radio.value === 'Freelance' ? 'xxxx MAD/jour' : 'xxxx MAD/mois';
          infoInput.disabled = false;
          infoInput.value = '';
          form.dataset.infoLabel = label;
        });
      });
    }

    fileDrop.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', () => {
      if (fileInput.files?.[0]) fileNameEl.textContent = fileInput.files[0].name;
    });

    function showStatus(type: 'success' | 'error' | '', message: string) {
      statusEl.className = type
        ? `mt-3 rounded-lg px-4 py-2.5 text-sm ${type === 'success' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`
        : 'mt-3 hidden';
      statusEl.textContent = message;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      showStatus('', '');

      const file = fileInput.files?.[0];
      if (!file) {
        showStatus('error', 'Merci de joindre votre CV.');
        return;
      }
      if (file.size > MAX_FILE_SIZE) {
        showStatus('error', 'Le fichier dépasse 5 Mo. Merci de réduire sa taille.');
        return;
      }
      if (WEBAPP_URL.includes('REMPLACER_PAR_URL')) {
        showStatus('error', "Configuration incomplète : l'URL du formulaire n'a pas été définie.");
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Envoi en cours...';

      const typeContratSouhaite = hasChoice
        ? form.querySelector<HTMLInputElement>('input[name="typeContratSouhaite"]:checked')?.value
        : undefined;
      if (hasChoice && !typeContratSouhaite) {
        showStatus('error', 'Merci de choisir un type de contrat (Freelance ou CDI).');
        return;
      }

      try {
        const cvBase64 = await fileToBase64(file);
        const payload = {
          posteSlug: form.dataset.slug,
          poste: form.dataset.poste,
          lieu: form.dataset.lieu,
          typeContrat: typeContratSouhaite || form.dataset.contrat,
          objetMail: form.dataset.objet,
          infoLabel: typeContratSouhaite ? infoLabelFor(typeContratSouhaite) : form.dataset.infoLabel,
          nom: (form.querySelector('#nom') as HTMLInputElement).value.trim(),
          prenom: (form.querySelector('#prenom') as HTMLInputElement).value.trim(),
          telephone: (form.querySelector('#telephone') as HTMLInputElement).value.trim(),
          email: (form.querySelector('#email') as HTMLInputElement).value.trim(),
          infoValeur: (form.querySelector('#infoValeur') as HTMLInputElement).value.trim(),
          disponibilite: (form.querySelector('#disponibilite') as HTMLSelectElement).value,
          message: (form.querySelector('#message') as HTMLTextAreaElement).value.trim(),
          cvFileName: file.name,
          cvMimeType: file.type,
          cvBase64,
        };

        // Content-Type volontairement omis (texte brut) pour éviter le
        // préflight CORS que Google Apps Script ne gère pas.
        await fetch(WEBAPP_URL, {
          method: 'POST',
          body: JSON.stringify(payload),
        });

        showStatus('success', 'Votre candidature a bien été envoyée. Merci, nous reviendrons vers vous rapidement !');
        form.reset();
        fileNameEl.textContent = '';
        if (hasChoice) {
          infoInput.disabled = true;
          infoInput.placeholder = "Choisissez d'abord un type de contrat";
          infoLabelEl.textContent = form.dataset.infoLabel || '';
        }
      } catch (err) {
        showStatus('error', 'Une erreur est survenue lors de l\'envoi. Merci de réessayer.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Envoyer ma candidature';
      }
    });
  });
</script>
