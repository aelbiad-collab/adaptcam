---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ApplyForm from '../../components/ApplyForm.astro';
import { JOBS } from '../../data/jobs';

export const prerender = true;

export function getStaticPaths() {
  return JOBS.map((job) => ({ params: { slug: job.slug }, props: { job } }));
}

const { job } = Astro.props;
---

<BaseLayout
  title={`${job.intitule} — Adaptive IT`}
  description={job.accroche}
>
  <Header />

  <section class="border-b border-border bg-paper">
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
      <a href="/" class="text-sm text-muted hover:text-accent">&larr; Toutes les offres</a>
      <span class="mt-4 block text-xs font-semibold uppercase tracking-[0.2em] text-accent">{job.surtitre}</span>
      <h1 class="mt-3 font-display text-3xl font-bold leading-tight text-ink sm:text-4xl">{job.intitule}</h1>
      <p class="mt-4 text-lg text-muted">{job.accroche}</p>
      <div class="mt-6 flex flex-wrap gap-2 text-sm">
        <span class="rounded-full border border-border bg-white px-4 py-1.5 text-ink">{job.lieu}</span>
        <span class="rounded-full border border-border bg-white px-4 py-1.5 text-ink">{job.typeContrat}</span>
        <span class="rounded-full border border-border bg-white px-4 py-1.5 text-ink">{job.duree}</span>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h2 class="font-display text-2xl font-bold text-ink">Compétences clés</h2>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2">
      {job.puces.map((p) => (
        <li class="rounded-xl border border-border bg-white px-4 py-3 text-sm text-ink">{p}</li>
      ))}
    </ul>
    <p class="mt-4 rounded-xl border border-border bg-paper-dim px-4 py-3 text-sm font-semibold text-ink">
      {job.puceDiplome}
    </p>
  </section>

  <section class="border-t border-border bg-paper-dim">
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <h2 class="font-display text-2xl font-bold text-ink">Contexte</h2>
      <p class="mt-4 text-muted">{job.contexte}</p>

      <h2 class="mt-10 font-display text-2xl font-bold text-ink">Missions</h2>
      <ul class="mt-4 space-y-2">
        {job.missions.map((m) => (
          <li class="flex gap-3 text-muted">
            <span class="mt-1 text-accent">&rarr;</span>
            <span>{m}</span>
          </li>
        ))}
      </ul>

      <h2 class="mt-10 font-display text-2xl font-bold text-ink">Profil recherché</h2>
      <ul class="mt-4 space-y-2">
        {job.profil.map((p) => (
          <li class="flex gap-3 text-muted">
            <span class="mt-1 text-accent">&rarr;</span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-t border-border bg-paper">
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <h2 class="font-display text-2xl font-bold text-ink">Postuler</h2>
      <p class="mt-2 mb-6 text-sm text-muted">
        Objet suggéré pour toute candidature par email : <strong>{job.objetMail}</strong> — ou utilisez le formulaire
        ci-dessous.
      </p>
      <ApplyForm job={job} />
    </div>
  </section>

  <Footer />
</BaseLayout>
